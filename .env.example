# Copiar a .env y cifrar con SOPS antes de versionar.
# La forma de este archivo la valida packages/contracts/env.ts (Zod) al arrancar:
# si falta una variable, el proceso falla al iniciar, no a medio camino.

# ---- Base de datos ----
POSTGRES_USER=gs_admin
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gs_admin:${POSTGRES_PASSWORD}@postgres:5432/gs_control_center

# ---- Redis ----
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ---- Seguridad ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Clave maestra AES-256-GCM para credenciales de terceros. 32 bytes en base64.
# Nunca en la base de datos. Rotarla exige recifrar integrations.credentials.
ENCRYPTION_MASTER_KEY=

# ---- Dominios y TLS ----
ACME_EMAIL=
APP_DOMAIN=app.growthshell.com
API_DOMAIN=api.growthshell.com
INGEST_DOMAIN=hooks.growthshell.com
DOCS_DOMAIN=docs.growthshell.com
N8N_DOMAIN=flows.growthshell.com
DOCS_BASIC_AUTH=

# ---- Integraciones ----
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
AI_MONTHLY_TOKEN_BUDGET=2000000

# ---- Respaldos ----
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
RESTIC_PASSWORD=

# ---- Despliegue ----
GH_ORG=growthshell
TAG=latest
