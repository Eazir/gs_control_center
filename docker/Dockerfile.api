# Monorepo pnpm + Turborepo. Multi-stage para que la imagen final
# no arrastre ni el código fuente ni las dependencias de build.
FROM node:22-alpine AS base
RUN corepack enable && apk add --no-cache libc6-compat
WORKDIR /app

# --- Poda: solo el subgrafo de dependencias que 'api' necesita ---
FROM base AS pruner
COPY . .
RUN pnpm dlx turbo prune api --docker

# --- Dependencias (capa cacheable: solo cambia si cambian los lockfiles) ---
FROM base AS deps
COPY --from=pruner /app/out/json/ .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# --- Desarrollo (usado por docker-compose.override.yml) ---
FROM deps AS dev
COPY . .
ENV NODE_ENV=development
CMD ["pnpm", "--filter", "api", "dev"]

# --- Build ---
FROM deps AS builder
COPY --from=pruner /app/out/full/ .
RUN pnpm --filter api prisma generate \
 && pnpm --filter api build \
 && pnpm deploy --filter=api --prod /app/deploy

# --- Runtime ---
FROM node:22-alpine AS runner
RUN apk add --no-cache tini && addgroup -S app && adduser -S app -G app
WORKDIR /app
COPY --from=builder --chown=app:app /app/deploy ./
COPY --from=builder --chown=app:app /app/apps/api/dist ./dist
COPY --from=builder --chown=app:app /app/apps/api/prisma ./prisma
USER app
ENV NODE_ENV=production
# tini como PID 1: sin él, Node no recibe SIGTERM y los jobs de BullMQ
# se cortan a la mitad en cada despliegue.
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main.js", "--role=api"]
